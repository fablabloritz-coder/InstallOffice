<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Deploiement Office 2024"
        Width="1120" Height="828"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Brd" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="Fond" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FondCarte" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Texte" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Texte2" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
    <SolidColorBrush x:Key="AccentFonce" Color="#115EA3"/>
    <SolidColorBrush x:Key="Succes" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="Alerte" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Piste" Color="#EBEBEB"/>
    <!-- Libelles d'etat : portes par le XAML (UTF-8), le script reste en ASCII. -->
    <sys:String x:Key="EtatAttente">En attente</sys:String>
    <sys:String x:Key="EtatEncours">En cours</sys:String>
    <sys:String x:Key="EtatTermine">Terminé</sys:String>
    <sys:String x:Key="EtatSaute">Ignoré</sys:String>
    <sys:String x:Key="EtatErreur">Échec</sys:String>
    <Style x:Key="Carte" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource FondCarte}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brd}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="18,14,18,16"/>
    </Style>
    <Style x:Key="TitreCarte" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    </Style>
    <Style x:Key="Secondaire" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Texte2}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Bouton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Texte}"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6D6D6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F5F5F5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EDEDED"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BoutonPrimaire" TargetType="Button" BasedOn="{StaticResource Bouton}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentFonce}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#0C3B5E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BoutonFenetre" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource Texte2}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E9E9E9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Puce" TargetType="Border">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Background" Value="#EDEDED"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="GlyphePuce" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A8A8A"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Cadre" Background="{StaticResource Fond}" CornerRadius="10"
          BorderBrush="#DEDEDE" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <!-- Barre de titre -->
      <Grid Grid.Row="0" Background="#FBFBFB">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                Background="{StaticResource Accent}" Margin="16,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Text="O" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="10,0,0,0">
          <TextBlock Text="Déploiement Microsoft Office 2024" FontWeight="SemiBold"
                     Foreground="{StaticResource Texte}"/>
          <Border Background="#EDF4FB" CornerRadius="9" Padding="8,1" Margin="10,1,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="8.2.0.0" FontSize="11" Foreground="{StaticResource AccentFonce}"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnReduire" Style="{StaticResource BoutonFenetre}" Content="&#xE921;"/>
          <Button Style="{StaticResource BoutonFenetre}" Content="&#xE922;" IsEnabled="False"/>
          <Button x:Name="BtnFermer" Style="{StaticResource BoutonFenetre}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>

      <!-- Contenu -->
      <Grid Grid.Row="1" Margin="18,4,18,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.55*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <!-- Progression -->
          <Border Style="{StaticResource Carte}">
            <StackPanel>
              <Grid>
                <TextBlock Text="Progression" Style="{StaticResource TitreCarte}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="EtapePourcent" Text="0 %" Style="{StaticResource Secondaire}"/>
                  <TextBlock Text="  ·  5 étapes" Style="{StaticResource Secondaire}"/>
                </StackPanel>
              </Grid>

              <StackPanel Margin="0,14,0,0">
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Etape1" Style="{StaticResource Puce}">
                    <TextBlock x:Name="Glyphe1" Text="1" Style="{StaticResource GlyphePuce}"
                               Foreground="#FFFFFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="Titre1" Text="Désinstallation" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}"/>
                    <TextBlock Text="Retrait des versions précédentes d'Office"
                               Style="{StaticResource Secondaire}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="Etat1" Grid.Column="2" Text="En attente"
                             Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Etape2" Style="{StaticResource Puce}">
                    <TextBlock x:Name="Glyphe2" Text="2" Style="{StaticResource GlyphePuce}"
                               Foreground="#FFFFFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="Titre2" Text="Préparation" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}"/>
                    <TextBlock Text="Vérifications pré-vol, configuration ODT"
                               Style="{StaticResource Secondaire}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="Etat2" Grid.Column="2" Text="En attente"
                             Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Etape3" Style="{StaticResource Puce}">
                    <TextBlock x:Name="Glyphe3" Text="3" Style="{StaticResource GlyphePuce}"
                               Foreground="#FFFFFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="Titre3" Text="Sources" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}"/>
                    <TextBlock Text="Copie du dépôt ou téléchargement par setup.exe"
                               Style="{StaticResource Secondaire}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="Etat3" Grid.Column="2" Text="En attente"
                             Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Etape4" Style="{StaticResource Puce}">
                    <TextBlock x:Name="Glyphe4" Text="4" Style="{StaticResource GlyphePuce}"
                               Foreground="#FFFFFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="Titre4" Text="Installation" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}"/>
                    <TextBlock Text="Click-to-Run en mode silencieux"
                               Style="{StaticResource Secondaire}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="Etat4" Grid.Column="2" Text="En attente"
                             Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Etape5" Style="{StaticResource Puce}">
                    <TextBlock x:Name="Glyphe5" Text="5" Style="{StaticResource GlyphePuce}"
                               Foreground="#FFFFFF"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,1,0,0">
                    <TextBlock x:Name="Titre5" Text="Activation KMS" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}"/>
                    <TextBlock Text="ospp.vbs sur le serveur de l'académie"
                               Style="{StaticResource Secondaire}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="Etat5" Grid.Column="2" Text="En attente"
                             Style="{StaticResource Secondaire}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>

              <ProgressBar x:Name="Jauge" Height="6" Minimum="0" Maximum="100" Value="0"
                           Foreground="{StaticResource Accent}" Background="{StaticResource Piste}"
                           BorderThickness="0" Margin="0,16,0,0">
                <ProgressBar.Template>
                  <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ProgressBar.Template>
              </ProgressBar>

              <Grid Margin="0,10,0,0">
                <TextBlock x:Name="StatutTexte" Text="Pret." FontWeight="SemiBold"
                           Foreground="{StaticResource Texte}"/>
                <TextBlock x:Name="StatutDetail" Text="Aucun deploiement en cours"
                           Style="{StaticResource Secondaire}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Journal -->
          <Border Style="{StaticResource Carte}" Margin="0,14,0,0" Height="340">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Journal" Style="{StaticResource TitreCarte}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Text="Deploiement_20261122.log" Style="{StaticResource Secondaire}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="BtnEffacer" Style="{StaticResource Bouton}" Content="Effacer"
                          Padding="10,3" FontSize="12"/>
                  <Button x:Name="BtnExporter" Style="{StaticResource Bouton}" Content="Exporter"
                          Padding="10,3" FontSize="12" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#EDEDED" BorderThickness="1"
                      CornerRadius="6" Padding="12,8">
                <ScrollViewer x:Name="Defilement" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="Journal"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <!-- Pre-vol -->
          <Border Style="{StaticResource Carte}">
            <StackPanel>
              <Grid>
                <TextBlock Text="Vérifications pré-vol" Style="{StaticResource TitreCarte}"/>
                <Button x:Name="BtnRafraichir" Style="{StaticResource Bouton}" Content="Rafraîchir"
                        Padding="10,2" FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
              <StackPanel Margin="0,14,0,0">
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="setup.exe" Margin="10,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="Présent" Style="{StaticResource Secondaire}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Espace disque" Margin="10,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="212 Go" Style="{StaticResource Secondaire}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Réseau" Margin="10,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="KMS joignable" Style="{StaticResource Secondaire}"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                             Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="Windows" Margin="10,0,0,0"/>
                  <TextBlock Grid.Column="2" Text="11 24H2" Style="{StaticResource Secondaire}"/>
                </Grid>
              </StackPanel>
              <Border Background="#F7F7F7" CornerRadius="5" Padding="10,7" Margin="0,14,0,0">
                <TextBlock Text="Administrateur · poste LORITZ-PC042"
                           Style="{StaticResource Secondaire}"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Configuration -->
          <Border Style="{StaticResource Carte}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Configuration" Style="{StaticResource TitreCarte}"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Mode" Style="{StaticResource Secondaire}"/>
                <TextBlock Grid.Column="1" Text="Dépôt de sources" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="Sources" Style="{StaticResource Secondaire}"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="\\serveur\office" FontSize="12"
                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Text="Serveur KMS" Style="{StaticResource Secondaire}"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="kms.ac-nancy:1688" FontSize="12"
                           HorizontalAlignment="Right" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3" Text="Proxy" Style="{StaticResource Secondaire}"
                           Margin="0,8,0,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="Relais 127.0.0.1:52144"
                           FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Actions -->
          <Border Style="{StaticResource Carte}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Actions" Style="{StaticResource TitreCarte}"/>
              <Button x:Name="BtnInstaller" Style="{StaticResource BoutonPrimaire}"
                      Content="Installer Office 2024" Margin="0,12,0,0"/>
              <Button x:Name="BtnTester" Style="{StaticResource Bouton}"
                      Content="Tester le proxy" Margin="0,8,0,0"/>
              <Button x:Name="BtnReliquat" Style="{StaticResource Bouton}"
                      Content="Simuler un reliquat de proxy" Margin="0,8,0,0"/>
              <TextBlock Text="Aucune donnée n'est écrite sur le poste par cet aperçu."
                         Style="{StaticResource Secondaire}" TextWrapping="Wrap"
                         Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Pied -->
      <Border Grid.Row="2" Background="#FBFBFB" BorderBrush="#E9E9E9" BorderThickness="0,1,0,0"
              CornerRadius="0,0,10,10">
        <Grid Margin="18,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
            <TextBlock x:Name="PiedStatut" Text="Prêt à démarrer" Margin="8,0,0,0"
                       VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Lycée Loritz, Grand Est  ·  Installation hors ligne"
                     Style="{StaticResource Secondaire}" HorizontalAlignment="Right"
                     VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
