<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Deploiement Office 2024"
        Width="1240" Height="1000"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Libelles d'etat : propres a cette fenetre, portes par le XAML (UTF-8). -->
      <sys:String x:Key="EtatAttente">En attente</sys:String>
      <sys:String x:Key="EtatEncours">En cours</sys:String>
      <sys:String x:Key="EtatTermine">Terminé</sys:String>
      <sys:String x:Key="EtatSaute">Ignoré</sys:String>
      <sys:String x:Key="EtatErreur">Échec</sys:String>
      <!-- Libelles du pre-vol : poses par le XAML (UTF-8), le script reste ASCII. -->
      <sys:String x:Key="PreVolPresent">Présent</sys:String>
      <sys:String x:Key="PreVolAbsent">Absent</sys:String>
      <sys:String x:Key="PreVolNonTeste">Non testé</sys:String>
      <sys:String x:Key="PreVolInjoignable">injoignable</sys:String>
      <sys:String x:Key="PreVolSimule">valeurs simulées (mode capture)</sys:String>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{StaticResource Fond}" CornerRadius="10"
          BorderBrush="#DEDEDE" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="64"/>
      </Grid.RowDefinitions>

      <!-- Barre de titre -->
      <Grid Grid.Row="0" Background="#FBFBFB">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                Background="{StaticResource Accent}" Margin="16,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Text="O" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="10,0,0,0">
          <TextBlock Text="Déploiement Microsoft Office 2024" FontWeight="SemiBold"
                     Foreground="{StaticResource Texte}"/>
          <Border Background="#EDF4FB" CornerRadius="9" Padding="8,1" Margin="10,1,0,0"
                  VerticalAlignment="Center">
            <TextBlock Text="8.3.0.0" FontSize="11" Foreground="{StaticResource AccentFonce}"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnReduire" Style="{StaticResource BoutonFenetre}" Content="&#xE921;"/>
          <Button Style="{StaticResource BoutonFenetre}" Content="&#xE922;" IsEnabled="False"/>
          <Button x:Name="BtnFermer" Style="{StaticResource BoutonFenetre}" Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>

      <!-- Contenu -->
      <Grid Grid.Row="1" Margin="18,4,18,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.15*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Progression -->
          <Border Style="{StaticResource Carte}">
            <StackPanel>
              <Grid>
                <TextBlock Text="Progression" Style="{StaticResource TitreCarte}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock x:Name="EtapePourcent" Text="0 %" Style="{StaticResource Secondaire}"/>
                  <TextBlock Text="  ·  5 étapes" Style="{StaticResource Secondaire}"/>
                </StackPanel>
              </Grid>

              <Grid Margin="0,16,0,0">
                <Border Height="2" Background="#EDEDED" VerticalAlignment="Top"
                        Margin="52,15,52,0"/>
                <UniformGrid Columns="5">
                  <StackPanel>
                    <Border x:Name="Etape1" Style="{StaticResource Puce}" HorizontalAlignment="Center">
                      <TextBlock x:Name="Glyphe1" Text="1" Style="{StaticResource GlyphePuce}"
                                 Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="Titre1" Text="Désinstallation" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="Etat1" Text="En attente" FontSize="11"
                               Foreground="{StaticResource Texte2}" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <Border x:Name="Etape2" Style="{StaticResource Puce}" HorizontalAlignment="Center">
                      <TextBlock x:Name="Glyphe2" Text="2" Style="{StaticResource GlyphePuce}"
                                 Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="Titre2" Text="Préparation" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="Etat2" Text="En attente" FontSize="11"
                               Foreground="{StaticResource Texte2}" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <Border x:Name="Etape3" Style="{StaticResource Puce}" HorizontalAlignment="Center">
                      <TextBlock x:Name="Glyphe3" Text="3" Style="{StaticResource GlyphePuce}"
                                 Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="Titre3" Text="Sources" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="Etat3" Text="En attente" FontSize="11"
                               Foreground="{StaticResource Texte2}" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <Border x:Name="Etape4" Style="{StaticResource Puce}" HorizontalAlignment="Center">
                      <TextBlock x:Name="Glyphe4" Text="4" Style="{StaticResource GlyphePuce}"
                                 Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="Titre4" Text="Installation" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="Etat4" Text="En attente" FontSize="11"
                               Foreground="{StaticResource Texte2}" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                  <StackPanel>
                    <Border x:Name="Etape5" Style="{StaticResource Puce}" HorizontalAlignment="Center">
                      <TextBlock x:Name="Glyphe5" Text="5" Style="{StaticResource GlyphePuce}"
                                 Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="Titre5" Text="Activation KMS" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Texte}" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock x:Name="Etat5" Text="En attente" FontSize="11"
                               Foreground="{StaticResource Texte2}" HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </UniformGrid>
              </Grid>

              <ProgressBar x:Name="Jauge" Height="6" Minimum="0" Maximum="100" Value="0"
                           Foreground="{StaticResource Accent}" Background="{StaticResource Piste}"
                           BorderThickness="0" Margin="0,18,0,0">
                <ProgressBar.Template>
                  <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <Grid ClipToBounds="True">
                        <Border x:Name="PART_Track"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ProgressBar.Template>
              </ProgressBar>

              <!-- Activite de fond : son segment glisse et clignote pendant une
                   etape, sous la jauge qu'il double. En capture aucune animation
                   n'est demarree, donc la reference reste reproductible au pixel. -->
              <Grid x:Name="BandeActivite" Height="4" Margin="0,6,0,0" Visibility="Collapsed"
                    ClipToBounds="True" Background="{StaticResource Piste}">
                <Border x:Name="SegmentActivite" Width="190" HorizontalAlignment="Left"
                        Background="{StaticResource Accent}" CornerRadius="2">
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="GlissementActivite" X="0"/>
                  </Border.RenderTransform>
                </Border>
              </Grid>

              <Grid Margin="0,10,0,0">
                <TextBlock x:Name="StatutTexte" Text="Prêt." FontWeight="SemiBold"
                           Foreground="{StaticResource Texte}"/>
                <TextBlock x:Name="StatutDetail" Text="Aucun déploiement en cours"
                           Style="{StaticResource Secondaire}" HorizontalAlignment="Right"/>
              </Grid>

              <!-- Points de verification de l'etape en cours : remplis par le script
                   (un glyphe par point : vert pour un resultat constate, rouge pour un
                   echec ; la planche des etats montre aussi les etats a venir). -->
              <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                <TextBlock Text="Points de contrôle" Style="{StaticResource Secondaire}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel x:Name="PointsEtape" Orientation="Horizontal" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Pre-vol -->
          <Border Grid.Row="2" Style="{StaticResource Carte}">
            <StackPanel>
              <Grid>
                <TextBlock Text="Vérifications pré-vol" Style="{StaticResource TitreCarte}"/>
                <Button x:Name="BtnRafraichir" Style="{StaticResource BoutonSecondaire}" Content="Rafraîchir"
                        Padding="10,2" FontSize="12" HorizontalAlignment="Right"/>
              </Grid>
              <!-- Chaque ligne est nommee : le script y ecrit le resultat d'une mesure
                   (Ico* porte le glyphe d'etat, Val* la valeur constatee). -->
              <UniformGrid Columns="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock x:Name="IcoSetup" Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="#8A8A8A" VerticalAlignment="Center"/>
                  <TextBlock Text="setup.exe" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ValSetup" Text="Non mesuré" Style="{StaticResource Secondaire}"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <TextBlock x:Name="IcoDisque" Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="#8A8A8A" VerticalAlignment="Center"/>
                  <TextBlock Text="Espace disque" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ValDisque" Text="Non mesuré" Style="{StaticResource Secondaire}"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="IcoKms" Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="#8A8A8A" VerticalAlignment="Center"/>
                  <TextBlock Text="KMS" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ValKms" Text="Non mesuré" Style="{StaticResource Secondaire}"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="IcoWindows" Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                             Foreground="#8A8A8A" VerticalAlignment="Center"/>
                  <TextBlock Text="Windows" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ValWindows" Text="Non mesuré" Style="{StaticResource Secondaire}"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </UniformGrid>
              <Border Background="#F7F7F7" CornerRadius="5" Padding="10,6" Margin="0,12,0,0">
                <TextBlock x:Name="InfoPoste" Text="Mesures en attente du poste"
                           Style="{StaticResource Secondaire}" TextTrimming="CharacterEllipsis"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Journal -->
          <Border Grid.Row="4" Style="{StaticResource Carte}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Journal" Style="{StaticResource TitreCarte}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <TextBlock Text="Deploiement_20261122.log" Style="{StaticResource Secondaire}"
                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <Button x:Name="BtnEffacer" Style="{StaticResource BoutonSecondaire}" Content="Effacer"
                          Padding="10,3" FontSize="12"/>
                  <Button x:Name="BtnExporter" Style="{StaticResource BoutonSecondaire}" Content="Exporter"
                          Padding="10,3" FontSize="12" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
              <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#EDEDED" BorderThickness="1"
                      CornerRadius="6" Padding="12,8">
                <ScrollViewer x:Name="Defilement" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="Journal"/>
                </ScrollViewer>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Colonne options -->
        <Grid Grid.Column="2">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Carte}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Options" Style="{StaticResource TitreCarte}"/>

                <!-- Installation -->
                <TextBlock Text="Installation" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentFonce}" Margin="0,14,0,0"/>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Programme setup.exe" Style="{StaticResource Etiquette}"/>
                  <TextBox x:Name="ChampSetup" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="C:\InstallOffice2024\setup.exe"/>
                  <Button x:Name="BtnSetup" Grid.Column="2" Style="{StaticResource BoutonSecondaire}"
                          Content="Parcourir…" Padding="10,4" FontSize="12" Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Langue d'installation" Style="{StaticResource Etiquette}"/>
                  <Border x:Name="LangueChoix" Grid.Column="1" Style="{StaticResource Selecteur}"
                          HorizontalAlignment="Left" Width="130">
                    <Grid>
                      <TextBlock x:Name="LangueTexte" Text="fr-fr" FontSize="12"
                                 Foreground="{StaticResource Texte}"/>
                      <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                 Foreground="{StaticResource Texte2}" HorizontalAlignment="Right"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </Grid>
                <CheckBox x:Name="ChkRemoveOld" Style="{StaticResource Case}" Margin="0,12,0,0"
                          Content="Désinstaller l'ancienne version d'Office avant installation"/>
                <CheckBox x:Name="ChkInstall" Style="{StaticResource Case}" Margin="0,8,0,0"
                          Content="Lancer l'installation automatiquement après le téléchargement"
                          IsChecked="True"/>

                <TextBlock Text="Sources" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentFonce}" Margin="0,12,0,0"/>
                <CheckBox x:Name="ChkDepot" Style="{StaticResource Case}" Margin="0,8,0,0"
                          Content="Dépôt de sources (sans téléchargement)"/>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Dossier du dépôt" Style="{StaticResource Etiquette}"/>
                  <TextBox x:Name="ChampDepot" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="\\serveur\office" IsEnabled="False"/>
                  <Button x:Name="BtnDepot" Grid.Column="2" Style="{StaticResource BoutonSecondaire}"
                          Content="Parcourir…" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                          IsEnabled="False"/>
                </Grid>

                <TextBlock Text="Configuration XML" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentFonce}" Margin="0,12,0,0"/>
                <Grid Margin="0,7,0,0">
                  <RadioButton x:Name="RadXmlAuto" Style="{StaticResource Option}"
                               Content="Générer automatiquement" IsChecked="True"
                               VerticalAlignment="Center"/>
                  <Button x:Name="BtnApps" Style="{StaticResource BoutonSecondaire}"
                          Content="Personnaliser les apps…" Padding="10,4" FontSize="12"
                          HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="LblApps" Text="Exclues : Teams, OneDrive, Skype Entreprise"
                           Style="{StaticResource Secondaire}" Margin="24,4,0,0"/>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton x:Name="RadXmlFichier" Style="{StaticResource Option}"
                               Content="Utiliser un fichier" VerticalAlignment="Center"/>
                  <TextBox x:Name="ChampXml" Grid.Column="1" Style="{StaticResource Champ}"
                           Margin="8,0,0,0" IsEnabled="False"/>
                  <Button x:Name="BtnXml" Grid.Column="2" Style="{StaticResource BoutonSecondaire}"
                          Content="Parcourir…" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                          IsEnabled="False"/>
                </Grid>

                <TextBlock Text="Activation KMS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentFonce}" Margin="0,12,0,0"/>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="ChkKms" Style="{StaticResource Case}" Content="Activer via KMS"
                            IsChecked="True" VerticalAlignment="Center"/>
                  <TextBox x:Name="ChampKms" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="kms.ac-nancy.fr" Margin="10,0,0,0"/>
                  <Button x:Name="BtnTestKms" Grid.Column="2" Style="{StaticResource BoutonSecondaire}"
                          Content="Tester la connexion" Padding="10,4" FontSize="12"
                          Margin="8,0,0,0"/>
                </Grid>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Serveur KMS de secours" Style="{StaticResource Etiquette}"/>
                  <TextBox x:Name="ChampKmsSecours" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="kms2.ac-nancy.fr:1688"/>
                </Grid>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox x:Name="ChkCle" Style="{StaticResource Case}"
                            Content="Appliquer une clé produit" VerticalAlignment="Center"/>
                  <TextBox x:Name="ChampCle" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX" Margin="10,0,0,0"
                           IsEnabled="False"/>
                </Grid>

                <TextBlock Text="Proxy" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentFonce}" Margin="0,12,0,0"/>
                <CheckBox x:Name="ChkProxy" Style="{StaticResource Case}" Margin="0,8,0,0"
                          Content="Utiliser un proxy pour le téléchargement"/>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Adresse" Style="{StaticResource Etiquette}"/>
                    <TextBox x:Name="ChampProxy" Grid.Column="1" Style="{StaticResource Champ}"
                             Text="proxy.ac-nancy.fr" IsEnabled="False"/>
                    <TextBlock Grid.Column="2" Text="Port" Style="{StaticResource Etiquette}"
                               Margin="10,0,8,0"/>
                    <TextBox x:Name="ChampPort" Grid.Column="3" Style="{StaticResource Champ}"
                             Text="8080" Width="64" IsEnabled="False"/>
                  </Grid>
                </Grid>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Identifiants" Style="{StaticResource Etiquette}"/>
                  <TextBox x:Name="ChampProxyUser" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="eleve" IsEnabled="False"/>
                  <PasswordBox x:Name="ChampProxyPass" Grid.Column="2" Margin="8,0,0,0" Width="130"
                               Style="{StaticResource ChampSecret}" IsEnabled="False"/>
                  <Button x:Name="BtnTestProxy" Grid.Column="3" Style="{StaticResource BoutonSecondaire}"
                          Content="Tester le proxy" Padding="10,4" FontSize="12" Margin="8,0,0,0"
                          IsEnabled="False"/>
                </Grid>
                <Grid Margin="0,7,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Exceptions" Style="{StaticResource Etiquette}"/>
                  <TextBox x:Name="ChampBypass" Grid.Column="1" Style="{StaticResource Champ}"
                           Text="&lt;local&gt;;*.local" IsEnabled="False"/>
                </Grid>
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Pied -->
      <Border Grid.Row="2" Background="#FBFBFB" BorderBrush="#E9E9E9" BorderThickness="0,1,0,0"
              CornerRadius="0,0,10,10">
        <Grid Margin="18,0">
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                         Foreground="{StaticResource Succes}" VerticalAlignment="Center"/>
              <TextBlock x:Name="PiedStatut" Text="Prêt à démarrer" Margin="8,0,0,0"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Hors mode capture, le déploiement est réel (administrateur requis)." FontSize="11"
                       Foreground="#8A8A8A" Margin="20,2,0,0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <TextBlock Text="Lycée Loritz, Grand Est" Style="{StaticResource Secondaire}"
                       VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button x:Name="BtnActiver" Style="{StaticResource BoutonSecondaire}"
                    Content="Activer seulement" Padding="12,6" FontSize="12"/>
            <Button x:Name="BtnInstaller" Style="{StaticResource BoutonPrimaire}"
                    Content="Installer Office 2024" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
