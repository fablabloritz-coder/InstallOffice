<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etats des controles"
        Width="1216" Height="595"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary Source="Styles.xaml"/>
  </Window.Resources>

  <Border Background="{StaticResource Fond}" CornerRadius="10" BorderBrush="#DEDEDE"
          BorderThickness="1" Padding="24,22,24,20">
    <StackPanel>
      <TextBlock Text="États des contrôles" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource Texte}"/>
      <TextBlock FontSize="12" Foreground="{StaticResource Texte2}" TextWrapping="Wrap"
                 Margin="0,4,0,0">Survol, appui et focus sont forcés sur les propriétés de dépendance
        que surveillent les gabarits (IsMouseOver, IsPressed, IsKeyboardFocusWithin, IsKeyboardFocused) :
        les déclencheurs évalués restent ceux du dictionnaire partagé, avec l'héritage de BoutonPrimaire.
        Une cellule vide signifie que le contrôle n'a pas cet état.</TextBlock>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Variante" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Repos" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Survol" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Appui" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="4" Text="Focus" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="5" Text="Désactivé" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Fenetre principale : secondaire -->
        <TextBlock Grid.Row="1" Text="Fenêtre — secondaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="Sec_Repos" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="2" x:Name="Sec_Survol" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="3" x:Name="Sec_Appui" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="4" x:Name="Sec_Focus" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="5" x:Name="Sec_Off" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Fenetre principale : primaire -->
        <TextBlock Grid.Row="2" Text="Fenêtre — primaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="2" Grid.Column="1" x:Name="Pri_Repos" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="2" x:Name="Pri_Survol" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="3" x:Name="Pri_Appui" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="4" x:Name="Pri_Focus" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="5" x:Name="Pri_Off" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Dialogue : secondaire (noir systeme) -->
        <TextBlock Grid.Row="3" Text="Dialogue — secondaire (noir système)"
                   Style="{StaticResource Etiquette}" Margin="0,0,0,10"/>
        <Button Grid.Row="3" Grid.Column="1" x:Name="DlgSec_Repos" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="2" x:Name="DlgSec_Survol" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="3" x:Name="DlgSec_Appui" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="4" x:Name="DlgSec_Focus" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="5" x:Name="DlgSec_Off" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>

        <!-- Dialogue : primaire -->
        <TextBlock Grid.Row="4" Text="Dialogue — primaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="4" Grid.Column="1" x:Name="DlgPri_Repos" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="2" x:Name="DlgPri_Survol" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="3" x:Name="DlgPri_Appui" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="4" x:Name="DlgPri_Focus" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="5" x:Name="DlgPri_Off" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Barre de titre : pas de focus, les glyphes sont colles et rognes par la barre -->
        <TextBlock Grid.Row="5" Text="Barre de titre" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="5" Grid.Column="1" x:Name="Fen_Repos" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="5" Grid.Column="2" x:Name="Fen_Survol" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="5" Grid.Column="3" x:Name="Fen_Appui" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="5" Grid.Column="5" x:Name="Fen_Off" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Champ de saisie : survol gris, focus accent, pas d'appui -->
        <TextBlock Grid.Row="6" Text="Champ de saisie" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="Sai_Repos" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="190" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="2" x:Name="Sai_Survol" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="190" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="4" x:Name="Sai_Focus" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="190" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="5" x:Name="Sai_Off" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="190" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>

        <!-- Case a cocher -->
        <TextBlock Grid.Row="7" Text="Case à cocher" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="Chk_Repos" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="2" x:Name="Chk_Survol" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="4" x:Name="Chk_Focus" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="5" x:Name="Chk_Off" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>

        <!-- Case cochee : le focus doit rester visible sous le remplissage accent -->
        <TextBlock Grid.Row="8" Text="Case cochée" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <CheckBox Grid.Row="8" Grid.Column="1" x:Name="ChkC_Repos" Content="Activer le proxy"
                  IsChecked="True" Style="{StaticResource Case}" HorizontalAlignment="Center"
                  Margin="4,0,4,10"/>
        <CheckBox Grid.Row="8" Grid.Column="2" x:Name="ChkC_Survol" Content="Activer le proxy"
                  IsChecked="True" Style="{StaticResource Case}" HorizontalAlignment="Center"
                  Margin="4,0,4,10"/>
        <CheckBox Grid.Row="8" Grid.Column="4" x:Name="ChkC_Focus" Content="Activer le proxy"
                  IsChecked="True" Style="{StaticResource Case}" HorizontalAlignment="Center"
                  Margin="4,0,4,10"/>
        <CheckBox Grid.Row="8" Grid.Column="5" x:Name="ChkC_Off" Content="Activer le proxy"
                  IsChecked="True" Style="{StaticResource Case}" HorizontalAlignment="Center"
                  Margin="4,0,4,10"/>

        <!-- Bouton radio : meme anneau de focus que la case. Chaque bouton porte son
             propre GroupName, sinon les instances cochees se decocheraient entre elles. -->
        <TextBlock Grid.Row="9" Text="Bouton radio" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <RadioButton Grid.Row="9" Grid.Column="1" x:Name="Opt_Repos" Content="Automatique"
                     GroupName="Opt_Repos" Style="{StaticResource Option}" HorizontalAlignment="Center"
                     Margin="4,0,4,10"/>
        <RadioButton Grid.Row="9" Grid.Column="2" x:Name="Opt_Survol" Content="Automatique"
                     GroupName="Opt_Survol" Style="{StaticResource Option}" HorizontalAlignment="Center"
                     Margin="4,0,4,10"/>
        <RadioButton Grid.Row="9" Grid.Column="4" x:Name="Opt_Focus" Content="Automatique"
                     GroupName="Opt_Focus" Style="{StaticResource Option}" HorizontalAlignment="Center"
                     Margin="4,0,4,10"/>
        <RadioButton Grid.Row="9" Grid.Column="5" x:Name="Opt_Off" Content="Automatique"
                     GroupName="Opt_Off" Style="{StaticResource Option}" HorizontalAlignment="Center"
                     Margin="4,0,4,10"/>

        <!-- Bouton radio selectionne : le focus doit rester visible sous le point accent -->
        <TextBlock Grid.Row="10" Text="Bouton radio sélectionné" Style="{StaticResource Etiquette}"/>
        <RadioButton Grid.Row="10" Grid.Column="1" x:Name="OptC_Repos" Content="Automatique"
                     GroupName="OptC_Repos" IsChecked="True" Style="{StaticResource Option}"
                     HorizontalAlignment="Center" Margin="4,0,4,0"/>
        <RadioButton Grid.Row="10" Grid.Column="2" x:Name="OptC_Survol" Content="Automatique"
                     GroupName="OptC_Survol" IsChecked="True" Style="{StaticResource Option}"
                     HorizontalAlignment="Center" Margin="4,0,4,0"/>
        <RadioButton Grid.Row="10" Grid.Column="4" x:Name="OptC_Focus" Content="Automatique"
                     GroupName="OptC_Focus" IsChecked="True" Style="{StaticResource Option}"
                     HorizontalAlignment="Center" Margin="4,0,4,0"/>
        <RadioButton Grid.Row="10" Grid.Column="5" x:Name="OptC_Off" Content="Automatique"
                     GroupName="OptC_Off" IsChecked="True" Style="{StaticResource Option}"
                     HorizontalAlignment="Center" Margin="4,0,4,0"/>
      </Grid>

      <Border Background="#FFFFFF" BorderBrush="{StaticResource Brd}" BorderThickness="1"
              CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
        <TextBlock FontSize="12" Foreground="{StaticResource Texte2}" TextWrapping="Wrap">Au survol,
          le primaire reste bleu foncé (#115EA3) : son déclencheur l'emporte sur le gris hérité du
          secondaire. Le bouton de dialogue garde un texte noir. Au focus clavier, tous les boutons
          affichent un anneau d'accent hors du cadre, le champ prend une bordure accent, et la case
          comme le radio ajoutent ce même anneau. Le radio se grise désormais une fois désactivé ; la
          barre de titre n'a que le survol, ses glyphes collés étant rognés par la barre.</TextBlock>
      </Border>
    </StackPanel>
  </Border>
</Window>
