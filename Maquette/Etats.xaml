<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etats des controles"
        Width="980" Height="508"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary Source="Styles.xaml"/>
  </Window.Resources>

  <Border Background="{StaticResource Fond}" CornerRadius="10" BorderBrush="#DEDEDE"
          BorderThickness="1" Padding="24,22,24,20">
    <StackPanel>
      <TextBlock Text="États des contrôles" FontSize="20" FontWeight="SemiBold"
                 Foreground="{StaticResource Texte}"/>
      <TextBlock FontSize="12" Foreground="{StaticResource Texte2}" TextWrapping="Wrap"
                 Margin="0,4,0,0">Survol, appui et focus sont forcés sur les propriétés de dépendance
        que surveillent les gabarits (IsMouseOver, IsPressed, IsKeyboardFocusWithin, IsKeyboardFocused) :
        les déclencheurs évalués restent ceux du dictionnaire partagé, avec l'héritage de BoutonPrimaire.</TextBlock>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Variante" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Repos" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="2" Text="Survol" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="3" Text="Appui" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Grid.Column="4" Text="Désactivé" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Texte2}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Fenetre principale : secondaire -->
        <TextBlock Grid.Row="1" Text="Fenêtre — secondaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="Sec_Repos" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="2" x:Name="Sec_Survol" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="3" x:Name="Sec_Appui" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="1" Grid.Column="4" x:Name="Sec_Off" Content="Effacer"
                Style="{StaticResource BoutonSecondaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Fenetre principale : primaire -->
        <TextBlock Grid.Row="2" Text="Fenêtre — primaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="2" Grid.Column="1" x:Name="Pri_Repos" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="2" x:Name="Pri_Survol" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="3" x:Name="Pri_Appui" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="2" Grid.Column="4" x:Name="Pri_Off" Content="Installer Office 2024"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Dialogue : secondaire (noir systeme) -->
        <TextBlock Grid.Row="3" Text="Dialogue — secondaire (noir système)"
                   Style="{StaticResource Etiquette}" Margin="0,0,0,10"/>
        <Button Grid.Row="3" Grid.Column="1" x:Name="DlgSec_Repos" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="2" x:Name="DlgSec_Survol" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="3" x:Name="DlgSec_Appui" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <Button Grid.Row="3" Grid.Column="4" x:Name="DlgSec_Off" Content="Annuler"
                Style="{StaticResource BoutonSecondaire}" Foreground="#000000"
                HorizontalAlignment="Center" Margin="4,0,4,10"/>

        <!-- Dialogue : primaire -->
        <TextBlock Grid.Row="4" Text="Dialogue — primaire" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <Button Grid.Row="4" Grid.Column="1" x:Name="DlgPri_Repos" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="2" x:Name="DlgPri_Survol" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="3" x:Name="DlgPri_Appui" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>
        <Button Grid.Row="4" Grid.Column="4" x:Name="DlgPri_Off" Content="Appliquer"
                Style="{StaticResource BoutonPrimaire}" HorizontalAlignment="Center"
                Margin="4,0,4,10"/>

        <!-- Barre de titre -->
        <TextBlock Grid.Row="5" Text="Barre de titre" Style="{StaticResource Etiquette}"/>
        <Button Grid.Row="5" Grid.Column="1" x:Name="Fen_Repos" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"/>
        <Button Grid.Row="5" Grid.Column="2" x:Name="Fen_Survol" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"/>
        <Button Grid.Row="5" Grid.Column="3" x:Name="Fen_Appui" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"/>
        <Button Grid.Row="5" Grid.Column="4" x:Name="Fen_Off" Content="&#xE921;"
                Style="{StaticResource BoutonFenetre}" HorizontalAlignment="Center"/>

        <!-- Champ de saisie : survol gris, focus accent -->
        <TextBlock Grid.Row="6" Text="Champ de saisie" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="Sai_Repos" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="200" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="2" x:Name="Sai_Survol" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="200" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="3" x:Name="Sai_Focus" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="200" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>
        <TextBox Grid.Row="6" Grid.Column="4" x:Name="Sai_Off" Text="proxy.contoso.fr"
                 Style="{StaticResource Champ}" Width="200" HorizontalAlignment="Center"
                 Margin="4,0,4,10"/>

        <!-- Case a cocher : survol accent, aucun declencheur de focus -->
        <TextBlock Grid.Row="7" Text="Case à cocher" Style="{StaticResource Etiquette}"
                   Margin="0,0,0,10"/>
        <CheckBox Grid.Row="7" Grid.Column="1" x:Name="Chk_Repos" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="2" x:Name="Chk_Survol" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="3" x:Name="Chk_Focus" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
        <CheckBox Grid.Row="7" Grid.Column="4" x:Name="Chk_Off" Content="Activer le proxy"
                  Style="{StaticResource Case}" HorizontalAlignment="Center" Margin="4,0,4,10"/>
      </Grid>

      <Border Background="#FFFFFF" BorderBrush="{StaticResource Brd}" BorderThickness="1"
              CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
        <TextBlock FontSize="12" Foreground="{StaticResource Texte2}" TextWrapping="Wrap">Au survol,
          le primaire reste bleu foncé (#115EA3) : son déclencheur l'emporte sur le gris hérité du
          secondaire. Le bouton de dialogue garde un texte noir. La barre de titre n'a que le survol,
          et aucun état désactivé. Au focus clavier, le champ et la case prennent tous deux une bordure
          accent, comme le bouton radio du même dictionnaire.</TextBlock>
      </Border>
    </StackPanel>
  </Border>
</Window>
