<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Pinceaux communs -->
  <SolidColorBrush x:Key="Brd" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="Fond" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="FondCarte" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Texte" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="Texte2" Color="#5D5D5D"/>
  <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
  <SolidColorBrush x:Key="AccentFonce" Color="#115EA3"/>
  <SolidColorBrush x:Key="Succes" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="Piste" Color="#EBEBEB"/>
  <SolidColorBrush x:Key="ChampBord" Color="#D6D6D6"/>

  <!-- Cartes et textes -->
  <Style x:Key="Carte" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource FondCarte}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brd}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16,12,16,14"/>
  </Style>
  <Style x:Key="TitreCarte" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
  </Style>
  <Style x:Key="Secondaire" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Texte2}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="Etiquette" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Boutons : un seul gabarit, porte par le style secondaire. Le primaire n'en
       herite que pour changer des couleurs, la graisse et la marge interne.
       Couleur du texte : le secondaire pose #1B1B1B, la teinte de la fenetre
       principale. Les deux dialogues ecrivent Foreground="#000000" sur leur bouton
       secondaire : ils gardent ainsi le noir systeme qu'ils heritaient avant la
       fusion des styles, et leur rendu reste identique. -->
  <Style x:Key="BoutonSecondaire" TargetType="Button">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChampBord}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Anneau de focus, hors du bouton : il ne depend pas de la couleur
                 de fond, donc il reste lisible sur le bouton primaire. -->
            <Border x:Name="anneau" Margin="-3" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{StaticResource Accent}" Visibility="Collapsed"/>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="anneau" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#F5F5F5"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#EDEDED"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BoutonPrimaire" TargetType="Button" BasedOn="{StaticResource BoutonSecondaire}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,7"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentFonce}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#0C3B5E"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="BoutonFenetre" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{StaticResource Texte2}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Anneau de focus a l'interieur du bouton, contrairement aux autres
                 boutons : les glyphes se touchent dans la barre de titre, et un
                 anneau en debord passerait sous le voisin ou hors de la barre. -->
            <Border x:Name="anneau" Margin="1" CornerRadius="3" BorderThickness="2"
                    BorderBrush="{StaticResource Accent}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#E9E9E9"/>
            </Trigger>
            <!-- Pose apres le survol, donc prioritaire : sans lui l'appui rendait
                 le meme gris que le survol et la cellule Fen_Appui ne montrait rien. -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="anneau" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Meme traitement que les autres boutons : le glyphe s'efface. Sans cela
           la colonne "Desactive" de la planche montrait un glyphe identique au repos. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Puces du selecteur d'etapes -->
  <Style x:Key="Puce" TargetType="Border">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Background" Value="#EDEDED"/>
  </Style>
  <Style x:Key="GlyphePuce" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="#8A8A8A"/>
  </Style>

  <!-- Champs de saisie -->
  <Style x:Key="Champ" TargetType="TextBox">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChampBord}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#BDBDBD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChampSecret" TargetType="PasswordBox">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChampBord}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#BDBDBD"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Case a cocher -->
  <Style x:Key="Case" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <!-- Anneau de focus, hors du carre et cache au repos : il reste visible
                   quand la case est cochee, ou la bordure est deja accent. -->
              <Border x:Name="anneau" Margin="-3" CornerRadius="5" BorderThickness="2"
                      BorderBrush="{StaticResource Accent}" Visibility="Collapsed"/>
              <Border x:Name="box" CornerRadius="3"
                      Background="#FFFFFF" BorderBrush="#8A8A8A" BorderThickness="1">
                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                           FontSize="10" Foreground="#FFFFFF" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
              <Setter TargetName="anneau" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bouton radio -->
  <Style x:Key="Option" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Texte}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="anneau" Margin="-3" Stroke="{StaticResource Accent}" StrokeThickness="2"
                       Visibility="Collapsed"/>
              <Ellipse x:Name="cercle" Stroke="#8A8A8A" StrokeThickness="1" Fill="#FFFFFF"/>
              <Ellipse x:Name="point" Width="8" Height="8" Fill="{StaticResource Accent}"
                       Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="cercle" Property="Stroke" Value="{StaticResource Accent}"/>
              <Setter TargetName="point" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="cercle" Property="Stroke" Value="{StaticResource Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="cercle" Property="Stroke" Value="{StaticResource Accent}"/>
              <Setter TargetName="anneau" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Selecteur (liste deroulante simulee : l'apercu fait defiler les valeurs) -->
  <Style x:Key="Selecteur" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource ChampBord}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
</ResourceDictionary>
