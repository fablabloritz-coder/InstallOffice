<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnalisation des applications Office 2024"
        Width="620" Height="560"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </Window.Resources>

  <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#DEDEDE" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="24,22,24,0">
        <TextBlock Text="Applications à installer" FontSize="20" FontWeight="SemiBold"
                   Foreground="#1B1B1B"/>
        <TextBlock Text="Une application décochée est exclue de l'installation (ProPlus2024Volume)."
                   FontSize="12" Foreground="#5D5D5D" Margin="0,3,0,0"/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="24,16,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="0.95*"/>
          <ColumnDefinition Width="20"/>
          <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <CheckBox x:Name="AppWord" Style="{StaticResource Case}" Content="Word" IsChecked="True"
                    Margin="0,0,0,4"/>
          <TextBlock Text="Traitement de texte" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppExcel" Style="{StaticResource Case}" Content="Excel" IsChecked="True"
                    Margin="0,0,0,4"/>
          <TextBlock Text="Tableur" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppPowerPoint" Style="{StaticResource Case}" Content="PowerPoint"
                    IsChecked="True" Margin="0,0,0,4"/>
          <TextBlock Text="Présentations" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppOutlook" Style="{StaticResource Case}" Content="Outlook"
                    IsChecked="True" Margin="0,0,0,4"/>
          <TextBlock Text="Messagerie et agenda" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppOneNote" Style="{StaticResource Case}" Content="OneNote"
                    IsChecked="True" Margin="0,0,0,4"/>
          <TextBlock Text="Prise de notes" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppAccess" Style="{StaticResource Case}" Content="Access"
                    IsChecked="True" Margin="0,0,0,4"/>
          <TextBlock Text="Base de données" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,8"/>
          <CheckBox x:Name="AppTeams" Style="{StaticResource Case}" Content="Teams"
                    Margin="0,0,0,4"/>
          <TextBlock Text="Collaboration (optionnel)" FontSize="11" Foreground="#8A8A8A"
                     Margin="24,0,0,8"/>
          <CheckBox x:Name="AppOneDrive" Style="{StaticResource Case}" Content="OneDrive"
                    Margin="0,0,0,4"/>
          <TextBlock Text="Synchronisation cloud" FontSize="11" Foreground="#8A8A8A"
                     Margin="24,0,0,8"/>
          <CheckBox x:Name="AppLync" Style="{StaticResource Case}" Content="Skype Entreprise"
                    Margin="0,0,0,4"/>
          <TextBlock Text="UC legacy (obsolète)" FontSize="11" Foreground="#8A8A8A" Margin="24,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Aperçu du fichier XML" FontSize="12" FontWeight="SemiBold"
                     Foreground="#1B1B1B"/>
          <Border Background="#FAFAFA" BorderBrush="#EDEDED" BorderThickness="1" CornerRadius="6"
                  Padding="10,8" Margin="0,8,0,0">
            <TextBlock x:Name="XmlApercu" FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                       Foreground="#3C3C3C" TextWrapping="Wrap" LineHeight="15"><Run Text="&lt;Configuration&gt;"/><LineBreak/><Run Text="  &lt;Add SourcePath=&quot;...&quot; OfficeClientEdition=&quot;64&quot; /&gt;"/><LineBreak/><Run Text="  &lt;Product ID=&quot;ProPlus2024Volume&quot;&gt;"/><LineBreak/><Run Text="    &lt;Language ID=&quot;fr-fr&quot; /&gt;"/><LineBreak/><Run Text="    &lt;ExcludeApp ID=&quot;Teams&quot; /&gt;"/><LineBreak/><Run Text="    &lt;ExcludeApp ID=&quot;OneDrive&quot; /&gt;"/><LineBreak/><Run Text="    &lt;ExcludeApp ID=&quot;Lync&quot; /&gt;"/><LineBreak/><Run Text="  &lt;/Product&gt;"/><LineBreak/><Run Text="&lt;/Configuration&gt;"/></TextBlock>
          </Border>
          <TextBlock Text="Le XML est régénéré à chaque changement de case."
                     FontSize="11" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,10,10" Padding="24,14">
        <Grid>
          <TextBlock x:Name="ResumeApps" Text="6 applications incluses, 3 exclues"
                     FontSize="12" Foreground="#8A8A8A" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAnnuler" Style="{StaticResource BoutonSecondaire}"
                    Content="Annuler"/>
            <Button x:Name="BtnAppliquer" Style="{StaticResource BoutonPrimaire}"
                    Content="Appliquer" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
