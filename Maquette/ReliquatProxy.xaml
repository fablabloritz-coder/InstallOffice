<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reliquat de proxy"
        Width="560" Height="392"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    </ResourceDictionary>
  </Window.Resources>

  <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="#DEDEDE" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- En-tete -->
      <Grid Grid.Row="0" Margin="24,22,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="36" Height="36" CornerRadius="18" Background="#FFF4CE"
                VerticalAlignment="Top">
          <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                     Foreground="#9D5D00" HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <TextBlock Text="Reliquat de proxy" FontSize="20" FontWeight="SemiBold"
                     Foreground="#1B1B1B"/>
          <TextBlock Text="Déploiement interrompu — accès réseau dégradé" FontSize="12"
                     Foreground="#5D5D5D" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>

      <!-- Corps -->
      <StackPanel Grid.Row="1" Margin="24,18,24,0">
        <TextBlock Foreground="#1B1B1B" TextWrapping="Wrap" LineHeight="19">
          La configuration proxy pointe vers 127.0.0.1:52144, un relais local qui ne
          répond plus. Tant qu'il reste en place, Windows, Office et le navigateur n'ont
          plus d'accès direct à Internet.
        </TextBlock>

        <Border Background="#FAFAFA" BorderBrush="#EDEDED" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="Couches concernées" FontWeight="SemiBold" FontSize="12"
                       Foreground="#5D5D5D"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="WinHTTP (machine)" Foreground="#1B1B1B" FontSize="12"/>
              <TextBlock Grid.Column="1" Text="127.0.0.1:52144"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         HorizontalAlignment="Right" Foreground="#1B1B1B"/>
              <TextBlock Grid.Row="1" Text="Session (HKCU)" Foreground="#1B1B1B"
                         FontSize="12" Margin="0,6,0,0"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="127.0.0.1:52144"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         HorizontalAlignment="Right" Margin="0,6,0,0" Foreground="#1B1B1B"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Remettre Windows et la session en accès direct ?"
                   FontWeight="SemiBold" Foreground="#1B1B1B" Margin="0,16,0,0"/>
        <TextBlock Text="La remise en accès direct n'est annoncée réussie que si netsh la confirme."
                   FontSize="12" Foreground="#5D5D5D" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- Boutons -->
      <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,10,10" Padding="24,14">
        <Grid>
          <TextBlock Text="Port enregistré : relay-port.txt" FontSize="12"
                     Foreground="#8A8A8A" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnConserver" Style="{StaticResource BoutonSecondaire}"
                    Content="Conserver le réglage" Foreground="#000000"/>
            <Button x:Name="BtnRestaurer" Style="{StaticResource BoutonPrimaire}"
                    Content="Remettre en accès direct" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
